#: ../../doc_src/cmds/echo.rst:2
msgid "echo - display a line of text"
msgstr "echo - テキストを表示する"

#: ../../doc_src/cmds/echo.rst:5
msgid "Synopsis"
msgstr "概要"

#: ../../doc_src/cmds/echo.rst:12
msgid "Description"
msgstr "説明"

#: ../../doc_src/cmds/echo.rst:16
msgid ""
"NOTE: This page documents the fish builtin ``echo``. To see the "
"documentation on any non-fish versions, use ``command man echo``."
msgstr ""
"注意: このページでは fish 組み込みの ``echo`` について説明します。 "
"fish 以外のバージョンのドキュメントを参照するには、 ``command man echo`` を使用してください。"

#: ../../doc_src/cmds/echo.rst:19
msgid "``echo`` displays *STRING* of text."
msgstr "``echo`` はテキスト(*STRING*)を表示します。"

#: ../../doc_src/cmds/echo.rst:21
msgid "The following options are available:"
msgstr "以下のオプションが利用可能です。"

#: ../../doc_src/cmds/echo.rst:23
msgid "**-n**"
msgstr "**-n**"

#: ../../doc_src/cmds/echo.rst:24
msgid "Do not output a newline."
msgstr "改行を出力しません。"

#: ../../doc_src/cmds/echo.rst:26
msgid "**-s**"
msgstr "**-s**"

#: ../../doc_src/cmds/echo.rst:27
msgid "Do not separate arguments with spaces."
msgstr "引数をスペースで区切りません。"

#: ../../doc_src/cmds/echo.rst:29
msgid "**-E**"
msgstr "**-E**"

#: ../../doc_src/cmds/echo.rst:30
msgid "Disable interpretation of backslash escapes (default)."
msgstr "バックスラッシュによるエスケープシーケンスの解釈を無効にします(デフォルト)。"

#: ../../doc_src/cmds/echo.rst:32
msgid "**-e**"
msgstr "**-e**"

#: ../../doc_src/cmds/echo.rst:33
msgid "Enable interpretation of backslash escapes."
msgstr "バックスラッシュによるエスケープシーケンスの解釈を有効にします。"

#: ../../doc_src/cmds/echo.rst:35
msgid ""
"Unlike other shells, this echo accepts ``--`` to signal the end of the "
"options."
msgstr ""
"他のシェルとは異なり、この echo はオプションの終わりを示す ``--`` を受け付けます。"

#: ../../doc_src/cmds/echo.rst:38
msgid "Escape Sequences"
msgstr "エスケープシーケンス"

#: ../../doc_src/cmds/echo.rst:40
msgid "If ``-e`` is used, the following sequences are recognized:"
msgstr "``-e`` が使用されている場合、以下のシーケンスが認識されます。"

#: ../../doc_src/cmds/echo.rst:42
msgid "``\\`` backslash"
msgstr "``\\`` バックスラッシュ"

#: ../../doc_src/cmds/echo.rst:44
msgid "``\\a`` alert (BEL)"
msgstr "``\\a`` 警告音 (BEL)"

#: ../../doc_src/cmds/echo.rst:46
msgid "``\\b`` backspace"
msgstr "``\\b`` バックスペース"

#: ../../doc_src/cmds/echo.rst:48
msgid "``\\c`` produce no further output"
msgstr "``\\c`` これ以降の出力を生成しない"

#: ../../doc_src/cmds/echo.rst:50
msgid "``\\e`` escape"
msgstr "``\\e`` エスケープ文字"

#: ../../doc_src/cmds/echo.rst:52
msgid "``\\f`` form feed"
msgstr "``\\f`` フォームフィード(改ページ)"

#: ../../doc_src/cmds/echo.rst:54
msgid "``\\n`` new line"
msgstr "``\\n`` 改行"

#: ../../doc_src/cmds/echo.rst:56
msgid "``\\r`` carriage return"
msgstr "``\\r`` 復帰(キャリッジリターン)"

#: ../../doc_src/cmds/echo.rst:58
msgid "``\\t`` horizontal tab"
msgstr "``\\t`` 水平タブ"

#: ../../doc_src/cmds/echo.rst:60
msgid "``\\v`` vertical tab"
msgstr "``\\v`` 垂直タブ"

#: ../../doc_src/cmds/echo.rst:62
msgid "``\\0NNN`` byte with octal value NNN (1 to 3 digits)"
msgstr "``\\0NNN`` 8進数値 NNN のバイト(1〜3桁)"

#: ../../doc_src/cmds/echo.rst:64
msgid "``\\xHH`` byte with hexadecimal value HH (1 to 2 digits)"
msgstr "``\\xHH`` 16進数値 HH のバイト(1〜2桁)"

#: ../../doc_src/cmds/echo.rst:67
msgid "Example"
msgstr "使用例"

#: ../../doc_src/cmds/echo.rst:82
msgid "See Also"
msgstr "関連項目"

#: ../../doc_src/cmds/echo.rst:84
msgid ""
"the :doc:`printf <printf>` command, for more control over output "
"formatting"
msgstr ":doc:`printf <printf>` コマンド: 出力形式をより細かく制御する場合に使用します。"
