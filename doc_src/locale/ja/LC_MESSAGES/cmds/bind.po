msgstr "選択範囲の文字の大文字・小文字を切り替えます。"

#: ../../doc_src/cmds/bind.rst:429
msgid "``insert-line-under``"
msgstr "``insert-line-under``"

#: ../../doc_src/cmds/bind.rst:430
msgid "add a new line under the current line"
msgstr "現在の行の下に新しい行を追加します。"

#: ../../doc_src/cmds/bind.rst:432
msgid "``insert-line-over``"
msgstr "``insert-line-over``"

#: ../../doc_src/cmds/bind.rst:433
msgid "add a new line over the current line"
msgstr "現在の行の上に新しい行を追加します。"

#: ../../doc_src/cmds/bind.rst:435
msgid "``up-line``"
msgstr "``up-line``"

#: ../../doc_src/cmds/bind.rst:436
msgid "move up one line"
msgstr "1 行上に移動します。"

#: ../../doc_src/cmds/bind.rst:438
msgid "``undo`` and ``redo``"
msgstr "``undo`` および ``redo``"

#: ../../doc_src/cmds/bind.rst:439
msgid "revert or redo the most recent edits on the command line"
msgstr "コマンドライン上の直近の編集を取り消す、またはやり直します。"

#: ../../doc_src/cmds/bind.rst:441
msgid "``upcase-word``"
msgstr "``upcase-word``"

#: ../../doc_src/cmds/bind.rst:442
msgid "make the current word uppercase"
msgstr "現在の単語を大文字にします。"

